{
  "name": "popai-animator",
  "productName": "Popai Animator",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Popai animation editor \u2014 TypeScript, React and Tauri (Rust)",
  "scripts": {
    "dev": "node scripts/build-engine.cjs && vite --host 127.0.0.1",
    "build": "node scripts/build-engine.cjs && tsc --noEmit && vite build",
    "test": "vitest run && node scripts/test-composition.mjs",
    "test:legacy": "node legacy/build.cjs && node legacy/regression.cjs && node legacy/vector-regression.cjs",
    "check": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "0.1.74",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
